# =============================================================
#  proj_rv32i .gitignore
#  RV32I CPU / APB bus 프로젝트 (VCS + Verdi + Vivado)
#  목적: 시뮬레이션/합성 산출물 및 개인 잡파일 커밋 방지
# =============================================================

# -------------------------------------------------------------
# 1. Makefile 기반 VCS 빌드 산출물 (make clean 대상 포함)
# -------------------------------------------------------------
build/                 # BUILD_DIR: simv, *.daidir 등 전체 빌드 결과
csrc/                  # VCS 컴파일 중간 산출물
simv                   # 시뮬레이션 실행 파일
simv.daidir/           # simv debug DB
*.daidir/
files.f                # generate_f 로 자동 생성되는 파일 리스트
ucli.key
vc_hdrs.h

# -------------------------------------------------------------
# 2. VCS / Synopsys 시뮬레이션 로그 · 임시 파일
# -------------------------------------------------------------
*.log
vcs.log
ucli.log
DVEfiles/
AN.DB/
.vcs_lib_lock
.vlogansetup.args
.vlogansetup.env
64/
*.vpd
*.vdb
coverage.vdb/          # SIMV_OPTS 커버리지 결과 (-cm_dir)
csrc.tmp/

# -------------------------------------------------------------
# 3. Verdi / novas 파형 · 디버그 파일
# -------------------------------------------------------------
novas*                 # novas.conf, novas.rc, nWaveLog 등
verdiLog/
*.fsdb
inter.fsdb
.inter.fsdb.tbsim
wave.fsdb
verdi_config_file
novas_dump.log
nWaveLog/
verdiLog

# -------------------------------------------------------------
# 4. UVM / 시뮬레이션 런타임 기타
# -------------------------------------------------------------
sys*                   # Makefile clean 대상 (syslog 등)
urg*
*.saif

# -------------------------------------------------------------
# 5. Xilinx Vivado 프로젝트 · 합성/구현 산출물
# -------------------------------------------------------------
*.jou
*.str
*.pb
vivado*.log
vivado*.backup.log
vivado.log

# Vivado 프로젝트 자동 생성 폴더 (project.xpr 만 커밋 권장)
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
.Xil/

# 합성/구현 결과 및 비트스트림
*.dcp
*.bit
*.ltx
*.rpt
*.dbg

# Vivado XSim (Vivado 자체 시뮬레이터를 쓸 경우)
xsim.dir/
webtalk*.jou
webtalk*.log
*.wdb
*.wcfg

# -------------------------------------------------------------
# 6. OS / 에디터 잡파일
# -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# -------------------------------------------------------------
# 7. 개인 AI 대화 메모 / 임시 문서 커밋 방지
#    - 최상위 README.md 만 예외로 추적 허용
# -------------------------------------------------------------
*.md                   # 기본적으로 모든 .md 무시
!README.md             #   단, 최상위 README 는 추적 (수정 권한 제어는 CODEOWNERS 로)

# AI 대화 결과물에 자주 붙는 이름 패턴
*_ai.md
*_gpt*.md
*_claude*.md
*_chat*.md
*_notes.md
*_memo.md
*_new.md
scratch/
tmp/
temp/
